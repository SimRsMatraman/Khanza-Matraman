	<queryString>
		<![CDATA[select 
reg_periksa.no_rawat, 
dokter.nm_dokter, 
dokter.no_ijn_praktek, 
dokter.nip1, 
pasien.tgl_lahir, 
pasien.nm_pasien, 
pasien.pekerjaan, 
surat_skbn.opiat, 
surat_skbn.benzodiazepin, 
surat_skbn.amphetamin, 
surat_skbn.ganja, 
surat_skbn.methamphetamin, 
concat(pasien.alamat,', ',kelurahan.nm_kel,', ',kecamatan.nm_kec,', ',kabupaten.nm_kab) as alamat, 
pasien.jk, 
reg_periksa.kd_dokter 
from reg_periksa 
inner join pasien 
inner join dokter 
inner join kelurahan 
inner join kecamatan 
inner join kabupaten 
inner join surat_skbn 
on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
and reg_periksa.kd_dokter=dokter.kd_dokter 
and pasien.kd_kel=kelurahan.kd_kel 
and surat_skbn.no_rawat=reg_periksa.no_rawat 
and pasien.kd_kec=kecamatan.kd_kec 
and pasien.kd_kab=kabupaten.kd_kab]]>
	</queryString>
