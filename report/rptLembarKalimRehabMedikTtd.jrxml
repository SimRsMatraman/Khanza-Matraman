	<queryString>
		<![CDATA[SELECT 
c.nm_pasien,
c.no_rkm_medis, 
c.umur, 
c.jk,
c.tgl_lahir, 
c.pekerjaan, 
concat(c.alamat,' ',e.nm_kel,' ',f.nm_kec,' ',g.nm_kab,' ',h.nm_prop) AS alamat, 
i.nm_poli, 
b.status_lanjut, 
a.*, 
j.nama, 
d.urut_kunjungan, 
b.status_lanjut, 
k.no_ijn_praktek
FROM pemeriksaan_ralan_rehab a
LEFT JOIN reg_periksa b on b.no_rawat = a.no_rawat
LEFT JOIN pasien c on c.no_rkm_medis = b.no_rkm_medis
LEFT JOIN kunjungan_fisio_rehab d on d.no_rawat = a.no_rawat
LEFT JOIN kelurahan e ON c.kd_kel = e.kd_kel 
LEFT JOIN kecamatan f ON c.kd_kec = f.kd_kec 
LEFT JOIN kabupaten g ON c.kd_kab = g.kd_kab 
LEFT JOIN propinsi h ON c.kd_prop = h.kd_prop
LEFT JOIN poliklinik i on b.kd_poli = i.kd_poli
LEFT JOIN pegawai j on a.nik = j.nik 
LEFT JOIN dokter k on k.kd_dokter = j.nik
WHERE a.no_rawat = $P{norawat}]]>
	</queryString>
